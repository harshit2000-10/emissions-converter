{
  "name": "emissions-converter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify-sources": "vitest run -c vitest.sources.config.ts",
    "desktop": "npm run build && electron .",
    "desktop:check": "npm run build && DESKTOP_CHECK=1 electron .",
    "desktop:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "description": "Offline emissions inventory and greenhouse gas converter for consultants.",
  "author": "SustivioLabs",
  "license": "MIT",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.sustiviolabs.emissions-converter",
    "productName": "Emissions Converter",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}
